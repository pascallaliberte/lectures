  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "sh -c 'if [ -f .env ]; then dotenv node build.js; else node build.js; fi' && yarn build-css && yarn build-js",
    "build-css": "sass _sass/main.scss dist/css/main.css",
    "build-js": "NODE_OPTIONS=--openssl-legacy-provider webpack",
    "watch": "yarn build && node watch.js"
  },
  "dependencies": {
    "ejs": "^2.6.1",
    "fs-extra": "^7.0.0",
    "jquery": "^3.3.1",
    "moment-timezone": "^0.5.27",
    "rimraf": "^2.6.2",
    "sass": "^1.85.0"
  },
  "devDependencies": {
    "dotenv-cli": "^4.0.0",
    "express": "^4.16.3",
    "webpack": "^4.41.2",
    "webpack-cli": "^3.3.10"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
